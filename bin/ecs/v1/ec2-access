#!/usr/bin/env bash

# Requires the `session-manager-plugin` to be installed:
# https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager-working-with-install-plugin.html

# exit on failures
set -e
set -o pipefail

usage() {
  echo "Usage: $(basename "$0") [OPTIONS]" 1>&2
  echo "  -h                     - help"
  echo "  -i <infrastructure>    - infrastructure name"
  echo "  -e <environment>       - environment name (e.g. 'staging' or 'prod')"
  echo "  -l                     - list available ec2 instance ids (optional)"
  echo "  -I <instance_id>       - ec2 instance id (optional; -I '' picks interactively)"
  echo "  -c                     - interactive choice (if multiple instances found)"
  exit 1
}

# if there are no arguments passed exit with usage
if [ $# -eq 0 ]
then
 usage
fi

if ! command -v session-manager-plugin > /dev/null
then
  err "This script requires the \`session-manager-plugin\` to be installed"
  log_info -l "https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager-working-with-install-plugin.html" -q "$QUIET_MODE"
  log_info -l "Also, If you are running an Mac M1 or above, you'll need to install Rosetta 2 by running:" -q "$QUIET_MODE"
  log_info -l "softwareupdate --install-rosetta" -q "$QUIET_MODE"
  exit 1
fi

CHOOSE=""
INSTANCE_ID_GIVEN=""

while getopts "i:e:I:lch" opt; do
  case $opt in
    i)
      INFRASTRUCTURE_NAME=$OPTARG
      ;;
    e)
      ENVIRONMENT=$OPTARG
      ;;
    l)
      LIST=1
      ;;
    I)
      INSTANCE_ID=$OPTARG
      INSTANCE_ID_GIVEN=1
      ;;
    c)
      CHOOSE=1
      ;;
    h)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

if [[
  -z "$INFRASTRUCTURE_NAME"
  || -z "$ENVIRONMENT"
]]
then
  usage
fi

log_info -l "Finding ECS instance..." -q "$QUIET_MODE"
INSTANCES=$(aws ec2 describe-instances --filters Name=instance-state-code,Values=16 Name=tag:Name,Values="$INFRASTRUCTURE_NAME-$ENVIRONMENT*")

AVAILABLE_INSTANCES="$(ec2_instance_lines -j "$INSTANCES")"
if [ -z "$AVAILABLE_INSTANCES" ]
then
  err "No instances found for Infrastructure '$INFRASTRUCTURE_NAME' Environment '$ENVIRONMENT'"
  exit 1
fi

if [ -n "$LIST" ]
then
  echo "$AVAILABLE_INSTANCES"
  exit 0
fi

if [ -z "$INSTANCE_ID" ]
then
  if [[ -n "$CHOOSE" || -n "$INSTANCE_ID_GIVEN" ]]
  then
    # -c asks, and so does an explicitly empty `-I ''` -- a way to reach the
    # picker without having to remember the flag
    INSTANCE_ID="$(pick_ec2_instance -j "$INSTANCES")"
  else
    # Unlike the ec2 v2 commands, the default here stays "just connect to one".
    # The first listed instance is .Reservations[0].Instances[0], and taking it
    # by parameter expansion avoids `| head -1`, which can trip `pipefail`
    FIRST_INSTANCE="${AVAILABLE_INSTANCES%%$'\n'*}"
    INSTANCE_ID="${FIRST_INSTANCE%% *}"
  fi
fi

# Doubles as validation of a `-I` argument: an id that is not in the running
# set resolves to no name. An empty Name tag must not be mistaken for that, so
# it is filtered to the "No Name" default -- jq treats "" as truthy, so without
# that a running instance tagged Name="" would be reported as not found
INSTANCE_NAME="$(echo "$INSTANCES" | jq -r --arg i "$INSTANCE_ID" \
  '.Reservations[].Instances[] | select(.InstanceId == $i) | (.Tags[]? | select(.Key == "Name") | .Value | select(. != "")) // "No Name"')"
if [ -z "$INSTANCE_NAME" ]
then
  err "Instance ID '$INSTANCE_ID' was not found or is not running"
  log_msg -l "Available instances:" -q "$QUIET_MODE"
  echo "$AVAILABLE_INSTANCES"
  exit 1
fi

log_info -l "Connecting to '$INSTANCE_NAME' (id: $INSTANCE_ID)..." -q "$QUIET_MODE"

aws ssm start-session --target "$INSTANCE_ID"
