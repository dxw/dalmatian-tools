#!/usr/bin/env bash

# exit on failures
set -e
set -o pipefail

usage() {
  echo "Generate the AWS SSO profiles for every Dalmatian account" 1>&2
  echo "Usage: $(basename "$0") [OPTIONS]" 1>&2
  echo "  -h                     - help" 1>&2
  exit 1
}

while getopts "h" opt; do
  case $opt in
    h)
      usage
      ;;
    *)
      usage
      ;;
  esac
done
shift $((OPTIND-1))

if [ "$#" -ne 0 ]
then
  usage
fi

log_info -l "Generating Dalmatian SSO configuration ..." -q "$QUIET_MODE"

AWS_SSO_START_URL="$(jq -r '.aws_sso.start_url' < "$CONFIG_SETUP_JSON_FILE")"
AWS_SSO_REGION="$(jq -r '.aws_sso.region' < "$CONFIG_SETUP_JSON_FILE")"
AWS_SSO_REGISTRATION_SCOPES="$(jq -r '.aws_sso.registration_scopes' < "$CONFIG_SETUP_JSON_FILE")"

# The profiles are assembled beside the live file and only moved into place
# once every workspace has been written, so a run that stops part-way (a
# cancelled SSO login, a missing state bucket) leaves the existing profiles
# usable rather than a file holding only the first two
NEW_CONFIG_FILE="$(mktemp "$(dirname "$CONFIG_AWS_SSO_FILE")/.dalmatian-sso.config.XXXXXX")"
STAGED_CONFIG_FILE=""

cleanup_new_config_file() {
  rm -f "$NEW_CONFIG_FILE"
  if [ -n "$STAGED_CONFIG_FILE" ]
  then
    rm -f "$STAGED_CONFIG_FILE"
  fi
}
trap cleanup_new_config_file EXIT
# A trapped signal does not end the script on its own; exiting here runs the
# EXIT trap and stops the live file being replaced by a partial one
trap 'exit 130' INT
trap 'exit 143' TERM

# Print every section of the live file ($2) whose "[...]" header is not one
# the generated file ($1) defines. This command owns the profiles it writes;
# anything else in the file (sso-session blocks, comments, profiles added by
# hand) belongs to the user and is carried over unchanged
carry_over_sections() {
  awk '
    NR == FNR { if ($0 ~ /^\[/) generated[$0] = 1; next }
    FNR == 1 { keep = 1 }
    /^\[/ { keep = !($0 in generated) }
    keep
  ' "$1" "$2"
}

# Replace the live file with the user's own sections followed by the generated
# ones, through a staging file and a rename so it is never seen part-written.
# User content goes first so anything written above the first header stays
# there from one run to the next instead of being read as the tail of the last
# generated profile
install_config_file() {
  STAGED_CONFIG_FILE="$(mktemp "$(dirname "$CONFIG_AWS_SSO_FILE")/.dalmatian-sso.config.XXXXXX")"
  if [ -f "$CONFIG_AWS_SSO_FILE" ]
  then
    carry_over_sections "$1" "$CONFIG_AWS_SSO_FILE" > "$STAGED_CONFIG_FILE"
  fi
  cat "$1" >> "$STAGED_CONFIG_FILE"
  mv "$STAGED_CONFIG_FILE" "$CONFIG_AWS_SSO_FILE"
  STAGED_CONFIG_FILE=""
}

cat <<EOT > "$NEW_CONFIG_FILE"
[profile dalmatian-login]
sso_start_url = $AWS_SSO_START_URL
sso_region = $AWS_SSO_REGION
sso_registration_scopes = $AWS_SSO_REGISTRATION_SCOPES

EOT

DALMATIAN_ACCOUNT_ID="$(jq -r '.main_dalmatian_account_id' < "$CONFIG_SETUP_JSON_FILE")"
DALMATIAN_ACCOUNT_ADMIN_ROLE_NAME="$(jq -r '.aws_sso.default_admin_role_name' < "$CONFIG_SETUP_JSON_FILE")"
DALMATIAN_ACCOUNT_DEFAULT_REGION="$(jq -r '.default_region' < "$CONFIG_SETUP_JSON_FILE")"

append_sso_config_file \
  "$NEW_CONFIG_FILE" \
  "dalmatian-main" \
  "$AWS_SSO_START_URL" \
  "$AWS_SSO_REGION" \
  "$DALMATIAN_ACCOUNT_ID" \
  "$DALMATIAN_ACCOUNT_ADMIN_ROLE_NAME" \
  "$DALMATIAN_ACCOUNT_DEFAULT_REGION"
echo ""

# The login and Terraform steps below run through bin/dalmatian, which pins
# AWS_CONFIG_FILE to the live file, so they cannot be pointed at the new one.
# Give the live file the dalmatian-login and dalmatian-main profiles from the
# current setup values, keeping every other section it holds so the account
# profiles stay usable if this run stops before the full file is written
install_config_file "$NEW_CONFIG_FILE"

"$APP_ROOT/bin/dalmatian" aws login -p dalmatian-login

"$APP_ROOT/bin/dalmatian" terraform-dependencies clone

"$APP_ROOT/bin/dalmatian" terraform-dependencies initialise

# Read the list into a variable rather than a process substitution, whose exit
# status set -e cannot see: a failed listing must stop the run, not commit a
# file with only the first two profiles
WORKSPACE_LIST="$("$APP_ROOT/bin/dalmatian" terraform-dependencies run-terraform-command -c "workspace list" -a -q)"

while IFS='' read -r workspace
do
  workspace=${workspace/\*/ }
  workspace=$(echo "$workspace" | xargs)
  MAIN_WORKSPACE_NAME="$DALMATIAN_ACCOUNT_ID-$DALMATIAN_ACCOUNT_DEFAULT_REGION-dalmatian-main"
  if [[
    "$workspace" != "$MAIN_WORKSPACE_NAME" &&
    "$workspace" != "default" &&
    -n "$workspace"
  ]]
  then
    log_info -l "Generating $workspace config ..." -q "$QUIET_MODE"
    SSO_CONFIG_ACCOUNT_ID="$(echo "$workspace" | cut -d"-" -f1)"
    SSO_CONFIG_REGION="$(echo "$workspace" | cut -d"-" -f2-4)"
    SSO_CONFIG_ACCOUNT_NAME="$(echo "$workspace" | cut -d"-" -f5-)"

    if [[ "$SSO_CONFIG_ACCOUNT_ID" == E* ]]
    then
      EXTERNAL_ROLE_ARN="arn:aws:iam::${SSO_CONFIG_ACCOUNT_ID:1}:role/$DALMATIAN_ACCOUNT_ID-dalmatian-access"
      append_sso_config_file_assume_role \
        "$NEW_CONFIG_FILE" \
        "$SSO_CONFIG_ACCOUNT_NAME" \
        "dalmatian-main" \
        "$EXTERNAL_ROLE_ARN" \
        "$SSO_CONFIG_REGION"
    else
      append_sso_config_file \
        "$NEW_CONFIG_FILE" \
        "$SSO_CONFIG_ACCOUNT_NAME" \
        "$AWS_SSO_START_URL" \
        "$SSO_CONFIG_REGION" \
        "$SSO_CONFIG_ACCOUNT_ID" \
        "$DALMATIAN_ACCOUNT_ADMIN_ROLE_NAME" \
        "$SSO_CONFIG_REGION"
    fi
  fi
done <<< "$WORKSPACE_LIST"

install_config_file "$NEW_CONFIG_FILE"
