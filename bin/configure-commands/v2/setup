#!/usr/bin/env bash
# shellcheck disable=SC2153

# exit on failures
set -e
set -o pipefail

log_msg -l "----------------------------------------------------" -q "$QUIET_MODE"
log_msg -l "| To enable us to deploy the resources across      |" -q "$QUIET_MODE"
log_msg -l "| multiple AWS accounts, we will configure AWS SSO |" -q "$QUIET_MODE"
log_msg -l "| and store the required AWS profiles, and other   |" -q "$QUIET_MODE"
log_msg -l "| configuration within:                            |" -q "$QUIET_MODE"
log_msg -l "| \`\$HOME/.config/dalmatian/installations/<name>\`   |" -q "$QUIET_MODE"
log_msg -l "|                                                  |" -q "$QUIET_MODE"
log_msg -l "| This configuration will then be automatically    |" -q "$QUIET_MODE"
log_msg -l "| loaded and used when running other dalmatian     |" -q "$QUIET_MODE"
log_msg -l "| tools commands                                   |" -q "$QUIET_MODE"
log_msg -l "----------------------------------------------------" -q "$QUIET_MODE"

usage() {
  echo "Usage: dalmatian $(basename "$0") [OPTIONS]" 1>&2
  echo "  -h                       - help"
  echo "  -n <installation_name>   - Name for this installation (Optional, defaults to the project name)"
  echo "  -f <setup_filepath>      - Setup Filepath (Optional)"
  echo "  -u <setup_url>           - Setup URL (Optional)"
  echo "  -b                       - Enable bootstrap (Optional)"
  exit 1
}
ENABLE_BOOTSTRAP=0
if [ "$DALMATIAN_BOOTSTRAP" == "true" ]
then
  ENABLE_BOOTSTRAP=1
fi

INSTALLATION_NAME=""
SETUP_FILE_PATH=""
SETUP_FILE_URL=""
while getopts "n:f:u:bh" opt; do
  case $opt in
    n)
      INSTALLATION_NAME="$OPTARG"
      ;;
    f)
      SETUP_FILE_PATH="$OPTARG"
      ;;
    u)
      SETUP_FILE_URL="$OPTARG"
      ;;
    b)
      ENABLE_BOOTSTRAP=1
      ;;
    h)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

if [[ -n "$INSTALLATION_NAME" ]] && ! installation_name_valid "$INSTALLATION_NAME"
then
  die "'$INSTALLATION_NAME' is not a valid installation name: use lower-case letters, digits, '-' and '_', starting with a letter or digit"
fi

# A plain re-run, with no file, URL or name, updates the installation the
# dispatcher resolved rather than creating a new one from the project name
if [[
  -z "$INSTALLATION_NAME" &&
  -z "$SETUP_FILE_PATH" &&
  -z "$SETUP_FILE_URL" &&
  -n "${DALMATIAN_INSTALLATION:-}"
]]
then
  INSTALLATION_NAME="$DALMATIAN_INSTALLATION"
fi

if [ -n "$SETUP_FILE_PATH" ]
then
  if [ -f "$SETUP_FILE_PATH" ]
  then
    SETUP_JSON=$(jq -r < "$SETUP_FILE_PATH")
    SETUP_JSON_SOURCE="file"
  else
    err "'$SETUP_FILE_PATH' doesn't exist!"
    exit 1
  fi
elif [ -n "$SETUP_FILE_URL" ]
then
  SETUP_JSON=$(curl -s "$SETUP_FILE_URL")
  SETUP_JSON_SOURCE="url"
elif [[ -n "$INSTALLATION_NAME" && -f "$CONFIG_INSTALLATIONS_DIR/$INSTALLATION_NAME/setup.json" ]]
then
  SETUP_JSON=$(jq -r < "$CONFIG_INSTALLATIONS_DIR/$INSTALLATION_NAME/setup.json")
  SETUP_JSON_SOURCE="existing"
else
  SETUP_JSON_SOURCE="template"
  SETUP_JSON=$(
    jq -n \
    --arg project_name "" \
    --arg default_region "" \
    --arg main_dalmatian_account_id "" \
    --arg aws_sso_start_url "" \
    --arg aws_sso_region "" \
    --arg aws_sso_registraion_scopes "sso:account:access" \
    --arg aws_sso_default_admin_role_name "" \
    --arg backend_s3_bucket_name "" \
    --arg backend_s3_bucket_region "" \
    '{
      project_name: $project_name,
      default_region: $default_region,
      main_dalmatian_account_id: $main_dalmatian_account_id,
      aws_sso: {
        start_url: $aws_sso_start_url,
        region: $aws_sso_region,
        registration_scopes: $aws_sso_registraion_scopes,
        default_admin_role_name: $aws_sso_default_admin_role_name
      },
      backend: {
        s3: {
          bucket_name: $backend_s3_bucket_name,
          bucket_region: $backend_s3_bucket_region
        }
      }
    }'
  )
fi

# The prompts read and write CONFIG_SETUP_JSON_FILE. The installation directory
# cannot exist until its name is known, and the name may come from the project
# name prompt, so stage the answers in a temporary file first.
STAGED_SETUP_JSON_FILE="$(mktemp)"
trap 'rm -f "$STAGED_SETUP_JSON_FILE"' EXIT
echo "$SETUP_JSON" > "$STAGED_SETUP_JSON_FILE"
CONFIG_SETUP_JSON_FILE="$STAGED_SETUP_JSON_FILE"
export CONFIG_SETUP_JSON_FILE

log_info -l "-- Dalmatian Setup --" -q "$QUIET_MODE"
PROJECT_NAME=$(read_prompt_with_setup_default -p "Dalmatian project name" -d "project_name")

if [ -z "$INSTALLATION_NAME" ]
then
  if ! installation_name_valid "$PROJECT_NAME"
  then
    die "The project name '$PROJECT_NAME' is not a valid installation name. Re-run with \`dalmatian setup -n <installation_name>\` to choose one (lower-case letters, digits, '-' and '_', starting with a letter or digit)"
  fi
  INSTALLATION_NAME="$PROJECT_NAME"
fi

# A blank template must never replace answers an earlier run recorded
if [[
  "$SETUP_JSON_SOURCE" == "template" &&
  -f "$CONFIG_INSTALLATIONS_DIR/$INSTALLATION_NAME/setup.json"
]]
then
  die "Installation '$INSTALLATION_NAME' already exists. Re-run with \`dalmatian setup -n $INSTALLATION_NAME\` to update it, or choose another name with -n"
fi

# From here on, everything this script and its child dalmatian invocations
# do targets the named installation
export DALMATIAN_INSTALLATION="$INSTALLATION_NAME"
export CONFIG_INSTALLATION_DIR="$CONFIG_INSTALLATIONS_DIR/$INSTALLATION_NAME"
export CONFIG_SETUP_JSON_FILE="$CONFIG_INSTALLATION_DIR/setup.json"
export CONFIG_AWS_SSO_FILE="$CONFIG_INSTALLATION_DIR/dalmatian-sso.config"
export CONFIG_CACHE_DIR="$CONFIG_INSTALLATION_DIR/.cache"
export CONFIG_ACCOUNT_BOOTSTRAP_BACKEND_VARS_FILE="$CONFIG_INSTALLATION_DIR/account-bootstrap-backend.vars"
export CONFIG_INFRASTRUCTURE_BACKEND_VARS_FILE="$CONFIG_INSTALLATION_DIR/infrastructure-backend.vars"
export CONFIG_TFVARS_DIR="$CONFIG_CACHE_DIR/tfvars"
export CONFIG_TFVARS_PATHS_FILE="$CONFIG_CACHE_DIR/tfvars-paths.json"
export TMP_DIR="$APP_ROOT/tmp/$INSTALLATION_NAME"
export TMP_ACCOUNT_BOOTSTRAP_TERRAFORM_DIR="$TMP_DIR/terraform-dxw-dalmatian-account-bootstrap"
export TMP_INFRASTRUCTURE_TERRAFORM_DIR="$TMP_DIR/terraform-dxw-dalmatian-infrastructure"
export TMP_SERVICE_ENV_DIR="$TMP_DIR/service-environment-files"

mkdir -p "$CONFIG_INSTALLATION_DIR" "$CONFIG_CACHE_DIR" "$TMP_DIR"
mv "$STAGED_SETUP_JSON_FILE" "$CONFIG_SETUP_JSON_FILE"
trap - EXIT

log_msg -l "Configuring installation '$INSTALLATION_NAME' in $CONFIG_INSTALLATION_DIR" -q "$QUIET_MODE"

DEFAULT_REGION=$(read_prompt_with_setup_default -p "Default AWS Region" -d "default_region")

log_info -l "-- AWS SSO configration --" -q "$QUIET_MODE"
read_prompt_with_setup_default -p "AWS SSO start URL" -d "aws_sso.start_url" -s
read_prompt_with_setup_default -p "AWS SSO Region" -d "aws_sso.region" -s
read_prompt_with_setup_default -p "AWS SSO Default administrative role name" -d "aws_sso.default_admin_role_name" -s
read_prompt_with_setup_default -p "AWS SSO Registration Scopes" -d "aws_sso.registration_scopes" -s

log_info -l "-- Backend Configuration --" -q "$QUIET_MODE"
log_msg -l "Enter the S3 backend configuration parameters" -q "$QUIET_MODE"
BACKEND_S3_BUCKET_NAME=$(read_prompt_with_setup_default -p "Bucket Name" -d "backend.s3.bucket_name")
BACKEND_S3_BUCKET_REGION=$(read_prompt_with_setup_default -p "Bucket Region" -d "backend.s3.bucket_region")

cat <<EOT > "$CONFIG_ACCOUNT_BOOTSTRAP_BACKEND_VARS_FILE"
bucket               = "$BACKEND_S3_BUCKET_NAME"
workspace_key_prefix = "account-bootstrap"
key                  = "terraform.tfstate"
region               = "$BACKEND_S3_BUCKET_REGION"
profile              = "dalmatian-main"
encrypt              = true
EOT

cat <<EOT > "$CONFIG_INFRASTRUCTURE_BACKEND_VARS_FILE"
bucket               = "$BACKEND_S3_BUCKET_NAME"
workspace_key_prefix = "infrastructure"
key                  = "terraform.tfstate"
region               = "$BACKEND_S3_BUCKET_REGION"
profile              = "dalmatian-main"
encrypt              = true
EOT

log_info -l "--- Dalmatian account configuration ---" -q "$QUIET_MODE"
MAIN_DALMATIAN_ACCOUNT_ID=$(read_prompt_with_setup_default -p "Main dalmatian account ID" -d "main_dalmatian_account_id")

"$APP_ROOT/bin/dalmatian" aws generate-config

INIT_COMMAND_OPTION=""
if [ "$ENABLE_BOOTSTRAP" -eq 1 ]
then
  INIT_COMMAND_OPTION="-d"
fi
"$APP_ROOT/bin/dalmatian" aws account-init -i "$MAIN_DALMATIAN_ACCOUNT_ID" -r "$DEFAULT_REGION" -n "dalmatian-main" $INIT_COMMAND_OPTION

if [ "$ENABLE_BOOTSTRAP" -eq 1 ]
then
  log_info -l "It is highly recommended to run the first account bootstrap for the main dalmatian account now, using \`dalmatian deploy account-bootstrap -a $MAIN_DALMATIAN_ACCOUNT_ID-$DEFAULT_REGION-dalmatian-main\`" -q "$QUIET_MODE"
  read -rp "Do you want to run this now? [y/n]: " DEPLOY_NOW
  if [[ "$DEPLOY_NOW" == "y" || "$DEPLOY_NOW" == "Y" ]]
  then
    "$APP_ROOT/bin/dalmatian" deploy account-bootstrap -a "$MAIN_DALMATIAN_ACCOUNT_ID-$DEFAULT_REGION-dalmatian-main"
  else
    log_info -l "You can run this at a later date by running: \`dalmatian deploy account-bootstrap -a $MAIN_DALMATIAN_ACCOUNT_ID-$DEFAULT_REGION-dalmatian-main\`" -q "$QUIET_MODE"
  fi
fi

CURRENT_DEFAULT="$(installation_default)"
if [ -z "$CURRENT_DEFAULT" ]
then
  set_installation_default "$INSTALLATION_NAME"
  log_info -l "'$INSTALLATION_NAME' is now the default installation" -q "$QUIET_MODE"
elif [ "$CURRENT_DEFAULT" != "$INSTALLATION_NAME" ]
then
  log_info -l "The default installation is still '$CURRENT_DEFAULT'" -q "$QUIET_MODE"
  log_msg -l "Run \`dalmatian installation use $INSTALLATION_NAME\` to switch, or set DALMATIAN_INSTALLATION=$INSTALLATION_NAME for one shell" -q "$QUIET_MODE"
fi

log_info -l "Setup complete!" -q "$QUIET_MODE"