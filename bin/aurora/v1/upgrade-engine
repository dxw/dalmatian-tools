#!/usr/bin/env bash

# exit on failures
set -e
set -o pipefail

usage() {
  echo "Usage: $(basename "$0") [OPTIONS]" 1>&2
  echo "  -h                     - help"
  echo "  -i <infrastructure>    - infrastructure name"
  echo "  -e <environment>       - environment name (e.g. 'staging' or 'prod')"
  echo "  -r <aurora_name>       - Aurora name (as defined in the Dalmatian config); picked if omitted"
  echo "  -v <target_version>    - minor engine version to upgrade to; picked if omitted"
  echo "  -a                     - apply immediately instead of in the next maintenance window"
  echo "  -y                     - do not ask for confirmation"
  echo
  echo "Upgrades an Aurora cluster to a newer minor engine version. Major version upgrades are not supported."
  echo "By default the upgrade is queued for the next maintenance window; with -a every instance restarts now."
  echo "Afterwards it says whether engine_version in the Dalmatian config needs changing, and when."
  exit 1
}

# if there are no arguments passed exit with usage
if [ $# -lt 1 ]
then
  usage
fi

APPLY_IMMEDIATELY=0
ASSUME_YES=0

while getopts "i:e:r:v:ayh" opt; do
  case $opt in
    i)
      INFRASTRUCTURE_NAME=$OPTARG
      ;;
    e)
      ENVIRONMENT=$OPTARG
      ;;
    r)
      AURORA_NAME=$OPTARG
      ;;
    v)
      TARGET_VERSION=$OPTARG
      ;;
    a)
      APPLY_IMMEDIATELY=1
      ;;
    y)
      ASSUME_YES=1
      ;;
    h)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

if [[
  -z "$INFRASTRUCTURE_NAME"
  || -z "$ENVIRONMENT"
]]
then
  usage
fi

NAME_PATTERN='^[A-Za-z0-9_.-]+$'
if [[ ! "$INFRASTRUCTURE_NAME" =~ $NAME_PATTERN || ! "$ENVIRONMENT" =~ $NAME_PATTERN ]]
then
  err "Infrastructure and environment names must be letters, digits, '.', '_' and '-'"
  exit 1
fi

# Dashes aren't allowed in RDS identifiers, so Dalmatian removes them on
# deployment
INFRASTRUCTURE_PREFIX="${INFRASTRUCTURE_NAME//-/}"
ENVIRONMENT_SUFFIX="${ENVIRONMENT//-/}"

if [ -z "$AURORA_NAME" ]
then
  log_info -l "Finding Aurora clusters in $INFRASTRUCTURE_NAME $ENVIRONMENT ..." -q "$QUIET_MODE"
  AURORA_LINES="$(
    aws rds describe-db-clusters \
      | jq -r --arg prefix "$INFRASTRUCTURE_PREFIX" --arg suffix "$ENVIRONMENT_SUFFIX" '
        .DBClusters[]
        | .DBClusterIdentifier as $id
        | select(($id | startswith($prefix)) and ($id | endswith($suffix))
          and ($id | length) > (($prefix + $suffix) | length))
        | "\($id[($prefix | length):(($id | length) - ($suffix | length))]) \(.Engine) \(.EngineVersion)"'
  )"
  AURORA_NAME="$(rds_pick -l "$AURORA_LINES" -n cluster -f -r)"
fi

rds_validate_names -i "$INFRASTRUCTURE_NAME" -e "$ENVIRONMENT" -r "$AURORA_NAME"

AURORA_IDENTIFIER="${INFRASTRUCTURE_PREFIX}${AURORA_NAME//-/}${ENVIRONMENT_SUFFIX}"

log_info -l "Getting Aurora info for $AURORA_IDENTIFIER ..." -q "$QUIET_MODE"

AURORA_INFO="$(aws rds describe-db-clusters --db-cluster-identifier "$AURORA_IDENTIFIER")"
ENGINE="$(jq -r '.DBClusters[0].Engine' <<< "$AURORA_INFO")"
CURRENT_VERSION="$(jq -r '.DBClusters[0].EngineVersion' <<< "$AURORA_INFO")"
DB_STATUS="$(jq -r '.DBClusters[0].Status' <<< "$AURORA_INFO")"
MAINTENANCE_WINDOW="$(jq -r '.DBClusters[0].PreferredMaintenanceWindow' <<< "$AURORA_INFO")"
PENDING_VERSION="$(jq -r '.DBClusters[0].PendingModifiedValues.EngineVersion // ""' <<< "$AURORA_INFO")"
AURORA_ARN="$(jq -r '.DBClusters[0].DBClusterArn' <<< "$AURORA_INFO")"
MEMBERS="$(jq -r '.DBClusters[0].DBClusterMembers[]?.DBInstanceIdentifier' <<< "$AURORA_INFO")"

if [ "$DB_STATUS" != "available" ]
then
  err "$AURORA_IDENTIFIER is $DB_STATUS. It can only be upgraded once it is available."
  exit 1
fi

if [ -n "$PENDING_VERSION" ]
then
  warning "$AURORA_IDENTIFIER already has a pending upgrade to $PENDING_VERSION. A new request replaces it."
fi

log_info -l "Finding upgrade targets for $ENGINE $CURRENT_VERSION ..." -q "$QUIET_MODE"

ENGINE_VERSIONS="$(
  aws rds describe-db-engine-versions \
    --engine "$ENGINE" \
    --engine-version "$CURRENT_VERSION" \
    --include-all
)"

if ! jq -e '(.DBEngineVersions // []) | length > 0' <<< "$ENGINE_VERSIONS" > /dev/null
then
  err "AWS returned no record of $ENGINE $CURRENT_VERSION, so its upgrade targets are unknown."
  exit 1
fi

MINOR_TARGETS="$(rds_minor_upgrade_targets -j "$ENGINE_VERSIONS")"

if [ -n "$TARGET_VERSION" ]
then
  if [[ "$TARGET_VERSION" == *$'\n'* ]] || ! grep -qFx -- "$TARGET_VERSION" <<< "$MINOR_TARGETS"
  then
    err "$TARGET_VERSION is not a minor upgrade target for $ENGINE $CURRENT_VERSION."
    if jq -e --arg v "$TARGET_VERSION" \
      'any(.DBEngineVersions[]?.ValidUpgradeTarget[]?; .EngineVersion == $v and .IsMajorVersionUpgrade == true)' \
      <<< "$ENGINE_VERSIONS" > /dev/null
    then
      err "Major version upgrades are not supported by this command."
    fi
    if [ -z "$MINOR_TARGETS" ]
    then
      log_msg -l "AWS offers no minor upgrade targets for $ENGINE $CURRENT_VERSION." -q "$QUIET_MODE" >&2
    else
      log_msg -l "Minor upgrade targets:" -q "$QUIET_MODE" >&2
      log_msg -l "$MINOR_TARGETS" -q "$QUIET_MODE" >&2
    fi
    exit 1
  fi
elif [ -z "$MINOR_TARGETS" ]
then
  log_msg -l "$AURORA_IDENTIFIER is already on the latest minor version of $ENGINE $CURRENT_VERSION. Nothing to upgrade to." -q "$QUIET_MODE"
  exit 0
else
  TARGET_VERSION="$(rds_pick -l "$MINOR_TARGETS" -n version -f -v)"
fi

if [ "$APPLY_IMMEDIATELY" -eq 0 ]
then
  WINDOW="$(rds_next_maintenance_window -w "$MAINTENANCE_WINDOW" -n "$(gdate +%s)")"
  read -r WINDOW_START WINDOW_END WINDOW_STATE <<< "$WINDOW"
  NEXT_WINDOW="$(gdate -u -d "$WINDOW_START" '+%a %d %b %Y %H:%M UTC') to $(gdate -u -d "$WINDOW_END" '+%a %d %b %Y %H:%M UTC')"
  if [ "$WINDOW_STATE" == "in-progress" ]
  then
    NEXT_WINDOW="$NEXT_WINDOW (in progress)"
  fi
fi

PENDING_ACTIONS="$(
  aws rds describe-pending-maintenance-actions \
    --resource-identifier "$AURORA_ARN" \
    | jq -r --arg arn "$AURORA_ARN" '.PendingMaintenanceActions[]?.PendingMaintenanceActionDetails[]? | "\($arn)\t\(.Action)\t\(.Description // "")"'
)"
CLUSTER_ACTIONS_BEFORE="$PENDING_ACTIONS"

# Advisory only, and nothing has changed yet: a member that cannot be looked
# up is skipped with a warning rather than stopping the command
while IFS= read -r MEMBER
do
  if [ -z "$MEMBER" ]
  then
    continue
  fi
  if ! MEMBER_ARN="$(
    aws rds describe-db-instances --db-instance-identifier "$MEMBER" \
      | jq -r '.DBInstances[0].DBInstanceArn // empty'
  )"
  then
    warning "Could not look up pending maintenance for cluster member $MEMBER."
    continue
  fi
  if [ -z "$MEMBER_ARN" ]
  then
    continue
  fi
  if ! MEMBER_ACTIONS="$(
    aws rds describe-pending-maintenance-actions \
      --resource-identifier "$MEMBER_ARN" \
      | jq -r --arg arn "$MEMBER_ARN" '.PendingMaintenanceActions[]?.PendingMaintenanceActionDetails[]? | "\($arn)\t\(.Action)\t\(.Description // "")"'
  )"
  then
    warning "Could not look up pending maintenance for cluster member $MEMBER."
    continue
  fi
  if [ -n "$MEMBER_ACTIONS" ]
  then
    PENDING_ACTIONS+="${PENDING_ACTIONS:+$'\n'}$MEMBER_ACTIONS"
  fi
done <<< "$MEMBERS"

# The operator answers the prompt on the strength of this summary, so without
# -y it goes to stderr even in quiet mode. QUIET_MODE is local because log_msg
# assigns the one it is given globally
summary() {
  local QUIET_MODE="$QUIET_MODE"
  if [ "$ASSUME_YES" -eq 0 ]
  then
    log_msg -l "$1" -q 0 >&2
  else
    log_msg -l "$1" -q "$QUIET_MODE"
  fi
}

summary ""
summary "Aurora cluster: $AURORA_IDENTIFIER ($INFRASTRUCTURE_NAME $ENVIRONMENT)"
summary "Engine: $ENGINE"
summary "Current version: $CURRENT_VERSION"
summary "Target version: $TARGET_VERSION"
summary "Maintenance window: $MAINTENANCE_WINDOW (UTC)"
if [ "$APPLY_IMMEDIATELY" -eq 1 ]
then
  summary "When: immediately"
  warning "The database restarts now and is unavailable while it upgrades."
  OTHER_PENDING="$(jq -r '.DBClusters[0].PendingModifiedValues // {} | del(.EngineVersion) | keys_unsorted | join(", ")' <<< "$AURORA_INFO")"
  if [ -n "$OTHER_PENDING" ]
  then
    warning "Applying now also applies the other changes already pending on $AURORA_IDENTIFIER: $OTHER_PENDING."
  fi
else
  summary "Next window: $NEXT_WINDOW"
fi
summary "Every instance in the cluster restarts during the upgrade."
summary ""
summary "Take a manual snapshot first:"
summary "  dalmatian aws exec -i $INFRASTRUCTURE_NAME rds create-db-cluster-snapshot --db-cluster-identifier $AURORA_IDENTIFIER --db-cluster-snapshot-identifier $AURORA_IDENTIFIER-pre-${TARGET_VERSION//[._]/-}"

if [ -n "$PENDING_ACTIONS" ]
then
  summary ""
  summary "Pending maintenance actions, which this command leaves alone:"
  while IFS=$'\t' read -r ACTION_ARN ACTION DESCRIPTION
  do
    summary "  $ACTION: $DESCRIPTION"
    summary "    dalmatian aws exec -i $INFRASTRUCTURE_NAME rds apply-pending-maintenance-action --resource-identifier $ACTION_ARN --apply-action $ACTION --opt-in-type next-maintenance"
  done <<< "$PENDING_ACTIONS"
fi
summary ""

if [ "$ASSUME_YES" -eq 0 ]
then
  if ! yes_no "Upgrade $AURORA_IDENTIFIER to $ENGINE $TARGET_VERSION? (y/N)" "n"
  then
    log_msg -l "Nothing was changed" -q "$QUIET_MODE"
    exit 0
  fi
fi

if [ "$APPLY_IMMEDIATELY" -eq 1 ]
then
  APPLY_FLAG="--apply-immediately"
else
  APPLY_FLAG="--no-apply-immediately"
fi

log_info -l "Requesting the upgrade of $AURORA_IDENTIFIER to $TARGET_VERSION ..." -q "$QUIET_MODE"

aws rds modify-db-cluster \
  --db-cluster-identifier "$AURORA_IDENTIFIER" \
  --engine-version "$TARGET_VERSION" \
  "$APPLY_FLAG" \
  > /dev/null

if ! AURORA_INFO="$(aws rds describe-db-clusters --db-cluster-identifier "$AURORA_IDENTIFIER")"
then
  err "AWS accepted the upgrade request, but it could not be confirmed: describing $AURORA_IDENTIFIER failed."
  err "Check with: dalmatian aws exec -i $INFRASTRUCTURE_NAME rds describe-db-clusters --db-cluster-identifier $AURORA_IDENTIFIER"
  exit 1
fi
NEW_STATUS="$(jq -r '.DBClusters[0].Status' <<< "$AURORA_INFO" 2> /dev/null)" || NEW_STATUS="unknown"
NEW_VERSION="$(jq -r '.DBClusters[0].EngineVersion' <<< "$AURORA_INFO" 2> /dev/null)" || NEW_VERSION="unknown"
PENDING_VERSION="$(jq -r '.DBClusters[0].PendingModifiedValues.EngineVersion // ""' <<< "$AURORA_INFO" 2> /dev/null)" || PENDING_VERSION=""

# A queued cluster engine upgrade is often reported only as a pending
# maintenance action. One counts as ours only if it is a db-upgrade that is new
# since before the request, or it names the target, so neither a stale
# db-upgrade nor an unrelated new system-update is mistaken for it;
# a failed lookup just means "not confirmed". Immediate upgrades are
# confirmed by status or version alone
QUEUED=0
if [ "$PENDING_VERSION" == "$TARGET_VERSION" ]
then
  QUEUED=1
elif [ "$APPLY_IMMEDIATELY" -eq 0 ]
then
  SHORT_TARGET="${TARGET_VERSION#*mysql_aurora.}"
  QUEUED_ACTIONS="$(aws rds describe-pending-maintenance-actions --resource-identifier "$AURORA_ARN")" || QUEUED_ACTIONS=""
  QUEUED_LINES="$(
    jq -r '.PendingMaintenanceActions[]?.PendingMaintenanceActionDetails[]? | select(.Action == "db-upgrade" or .Action == "system-update") | "\(.Action)\t\(.Description // "")"' \
      <<< "$QUEUED_ACTIONS" 2> /dev/null
  )" || QUEUED_LINES=""
  while IFS=$'\t' read -r QUEUED_ACTION QUEUED_DESCRIPTION
  do
    if [ -z "$QUEUED_ACTION" ]
    then
      continue
    fi
    if { [ "$QUEUED_ACTION" == "db-upgrade" ] \
      && ! grep -qFx -- "$QUEUED_ACTION"$'\t'"$QUEUED_DESCRIPTION" <<< "$(cut -f2- <<< "$CLUSTER_ACTIONS_BEFORE")"; } \
      || rds_text_names_version -t "$QUEUED_DESCRIPTION" -v "$TARGET_VERSION" \
      || rds_text_names_version -t "$QUEUED_DESCRIPTION" -v "$SHORT_TARGET"
    then
      QUEUED=1
    fi
  done <<< "$QUEUED_LINES"
fi

if [ "$APPLY_IMMEDIATELY" -eq 1 ] && {
  [ "$NEW_STATUS" == "upgrading" ] || [ "$QUEUED" -eq 1 ] || [ "$NEW_VERSION" == "$TARGET_VERSION" ]
}
then
  log_msg -l "Status: $NEW_STATUS" -q "$QUIET_MODE"
# The database was available before the modify, so an upgrading status or
# the target version means a queued upgrade AWS started straight away in an
# in-progress window, not something left over
elif [ "$APPLY_IMMEDIATELY" -eq 0 ] && {
  [ "$NEW_STATUS" == "upgrading" ] || [ "$NEW_VERSION" == "$TARGET_VERSION" ]
}
then
  log_msg -l "Status: $NEW_STATUS" -q "$QUIET_MODE"
  log_msg -l "AWS started the upgrade straight away, in the current maintenance window." -q "$QUIET_MODE"
elif [ "$APPLY_IMMEDIATELY" -eq 0 ] && [ "$QUEUED" -eq 1 ]
then
  log_msg -l "Pending engine version: $TARGET_VERSION" -q "$QUIET_MODE"
  if [ "$WINDOW_STATE" == "in-progress" ]
  then
    log_msg -l "It is applied in this maintenance window or the next one: $NEXT_WINDOW" -q "$QUIET_MODE"
  else
    log_msg -l "It is applied in the next maintenance window: $NEXT_WINDOW" -q "$QUIET_MODE"
  fi
else
  err "AWS accepted the upgrade request, but it could not be confirmed: $AURORA_IDENTIFIER is $NEW_STATUS on $NEW_VERSION with no pending upgrade to $TARGET_VERSION."
  err "Check with: dalmatian aws exec -i $INFRASTRUCTURE_NAME rds describe-db-clusters --db-cluster-identifier $AURORA_IDENTIFIER"
  exit 1
fi

log_msg -l "" -q "$QUIET_MODE"

# The upgrade has already been requested, so from here on nothing may fail
# the command: config that cannot be read falls back to the "could not read"
# advice, and an environment that cannot be described is reported as such
# No refresh here: with -i, assume-infrastructure-role already refreshed the
# config before switching to the infrastructure account's role
CONFIG_FILE="${DALMATIAN_CONFIG_PATH:-$APP_ROOT/bin/tmp/dalmatian-config/dalmatian.yml}"
CONFIG_VERSION="$(rds_v1_config_engine_version -f "$CONFIG_FILE" -i "$INFRASTRUCTURE_NAME" -b aurora -r "$AURORA_NAME")" || CONFIG_VERSION=""
CONFIG_STATUS="$(rds_config_version_status -c "$CONFIG_VERSION" -t "$TARGET_VERSION")"

ADVICE_ARGS=(
  -s "$CONFIG_STATUS"
  -t "$TARGET_VERSION"
  -w "engine_version for $AURORA_NAME in the aurora block of config/infrastructures/$INFRASTRUCTURE_NAME.yml (dalmatian-config)"
)
if [ "$APPLY_IMMEDIATELY" -eq 1 ]
then
  ADVICE_ARGS+=(-a)
fi

if [ "$CONFIG_STATUS" == "update" ]
then
  CONFIG_ENVIRONMENTS="$(rds_v1_config_environments -f "$CONFIG_FILE" -i "$INFRASTRUCTURE_NAME")" || CONFIG_ENVIRONMENTS=""
  OTHER_ENVIRONMENTS=""
  while IFS= read -r OTHER_ENVIRONMENT
  do
    if [[ -z "$OTHER_ENVIRONMENT" || "$OTHER_ENVIRONMENT" == "$ENVIRONMENT" ]]
    then
      continue
    fi
    if [[ ! "$OTHER_ENVIRONMENT" =~ $NAME_PATTERN ]]
    then
      OTHER_ENVIRONMENTS+="$OTHER_ENVIRONMENT not checked (unexpected name)"$'\n'
      continue
    fi
    OTHER_IDENTIFIER="${INFRASTRUCTURE_PREFIX}${AURORA_NAME//-/}${OTHER_ENVIRONMENT//-/}"
    # A filter, unlike --db-cluster-identifier, returns an empty list for a
    # missing cluster, so any failure is a real error and stderr can pass
    # straight through
    if OTHER_VERSION="$(
      aws rds describe-db-clusters \
        --filters "Name=db-cluster-id,Values=$OTHER_IDENTIFIER" \
        | jq -r '.DBClusters[0].EngineVersion // "not found"'
    )"
    then
      OTHER_ENVIRONMENTS+="$OTHER_ENVIRONMENT $OTHER_VERSION"$'\n'
    else
      OTHER_ENVIRONMENTS+="$OTHER_ENVIRONMENT not checked"$'\n'
      warning "Could not check the engine version of $AURORA_NAME in $OTHER_ENVIRONMENT."
    fi
  done <<< "$CONFIG_ENVIRONMENTS"

  if [ -n "$OTHER_ENVIRONMENTS" ]
  then
    ADVICE_ARGS+=(-o "${OTHER_ENVIRONMENTS%$'\n'}")
  fi
  if [ "$ENGINE" == "aurora-mysql" ]
  then
    ADVICE_ARGS+=(-m)
  fi
fi

rds_upgrade_config_advice "${ADVICE_ARGS[@]}"
